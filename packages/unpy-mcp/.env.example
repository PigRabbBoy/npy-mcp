# Required
NOTION_TOKEN_V2=your-token_v2-here
NOTION_MCP_AUTH_TOKEN=your-shared-secret

# Optional
NOTION_ALLOW_WRITE=0
NOTION_SPACE_ID=
# Comma-separated Host allowlist that keeps DNS-rebinding protection on for a
# non-loopback bind, e.g. mcp.example.com:*  (loopback binds are auto-protected)
NOTION_MCP_ALLOWED_HOSTS=
# Directory the file-reading write tools (import_csv, create_media) may open.
# Defaults to the server's working directory; set to / to allow any path.
NOTION_MCP_FILE_ROOT=
